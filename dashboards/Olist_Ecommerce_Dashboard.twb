  <worksheets>
    <worksheet name='Category Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular'>Top 10 Product Categories by Revenue</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='11'>Health &amp; Beauty</run>
            <run fontcolor='#000000' fontsize='11'> and </run>
            <run bold='true' fontcolor='#000000' fontsize='11'>Watches &amp; Gifts</run>
            <run fontcolor='#000000' fontsize='11'> generate the highest revenue among product categories.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders+ (olist_e_commerce)' name='federated.0e15faa0nunf2017x6ngg1i2jid9' />
          </datasources>
          <datasource-dependencies datasource='federated.0e15faa0nunf2017x6ngg1i2jid9'>
            <column caption='Category English' datatype='string' name='[category_english]' role='dimension' type='nominal' />
            <column-instance column='[category_english]' derivation='None' name='[none:category_english:nk]' pivot='key' type='nominal' />
            <column caption='Price' datatype='real' name='[price]' role='measure' type='quantitative' />
            <column-instance column='[price]' derivation='Sum' name='[sum:price:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0e15faa0nunf2017x6ngg1i2jid9].[none:category_english:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([price])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:category_english:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0e15faa0nunf2017x6ngg1i2jid9].[none:category_english:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0e15faa0nunf2017x6ngg1i2jid9].[sum:price:qk]' shelf='rows' />
          </shelf-sorts>
          <slices>
