    <worksheet name='Revenue Trend'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontsize='11'>Revenue rose sharply through </run>
            <run bold='true' fontcolor='#000000' fontsize='11'>2017</run>
            <run fontcolor='#000000' fontsize='11'> and peaked in </run>
            <run bold='true' fontcolor='#000000' fontsize='11'>November</run>
            <run fontcolor='#000000' fontsize='11'> during Black Friday.</run>
          </formatted-text>
        </caption>
      </layout-options>
