    <dashboard name='Olist E-Commerce Story' type='storyboard'>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='448' />
        </style-rule>
      </style>
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97916' id='1' param='vert' removable='false' type-v2='layout-flow' w='98828' x='586' y='1042'>
            <zone h='4297' id='3' type-v2='title' w='98828' x='586' y='1042' />
            <zone fixed-size='140' h='18229' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98828' x='586' y='5339' />
            <zone h='75390' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98828' x='586' y='23568'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Olist generated $13.2M in revenue across 96,478 delivered orders (Jan 2017 – Aug 2018). &#10;Revenue grew 9x in 2017 with a Black Friday peak in November. &#10;2018 stabilized at ~$900K/month. On-time delivery rate: 91.9%. Avg review score: 4.08/5.' captured-sheet='Executive Overview' id='1' />
                  <story-point caption='Late delivery is the #1 driver of poor customer experience — avg review score drops from 4.30 to 2.57 for late orders. &#10;Northeast states (AL: 24.2%, MA: 20.3%) have the worst delivery rates due to distance from seller hubs. &#10;Health &amp; Beauty and Watches &amp; Gifts are the top revenue-generating categories.' captured-sheet='Operations' id='2' />
                  <story-point caption='67% of all customers are concentrated in 3 Southeast states: SP (42%), RJ (13%), MG (12%). &#10;97% of customers placed only one order — retention is the biggest business challenge. &#10;Investing in loyalty programs and regional logistics in Northeast Brazil are the two highest-impact growth levers.' captured-sheet='Customer &amp; Products' id='3' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{0EE21CFA-03F8-4A36-8322-F4B598C69A21}' />
    </dashboard>
