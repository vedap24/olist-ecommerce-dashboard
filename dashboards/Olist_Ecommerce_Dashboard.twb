    <worksheet name='Late Delivery by State'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Regular'>Top 10 States by Late Delivery Rate</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='11'>AL</run>
            <run fontcolor='#000000' fontsize='11'> and </run>
            <run bold='true' fontcolor='#000000' fontsize='11'>MA</run>
            <run fontcolor='#000000' fontsize='11'> show the highest late delivery rates, indicating operational inefficiencies in these states.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_orders+ (olist_e_commerce)' name='federated.0e15faa0nunf2017x6ngg1i2jid9' />
          </datasources>
          <datasource-dependencies datasource='federated.0e15faa0nunf2017x6ngg1i2jid9'>
            <column caption='Late Delivery Rate' datatype='real' name='[Calculation_1985998476271620]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [is_late] = 1 THEN [order_id] END) / COUNTD([order_id]) * 100' />
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' type='nominal' />
            <column caption='Is Late' datatype='integer' name='[is_late]' role='measure' type='quantitative' />
            <column-instance column='[customer_state]' derivation='None' name='[none:customer_state:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1985998476271620]' derivation='User' name='[usr:Calculation_1985998476271620:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0e15faa0nunf2017x6ngg1i2jid9].[none:customer_state:nk]'>
            <groupfilter count='10' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='[Calculation_1985998476271620]' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:customer_state:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0e15faa0nunf2017x6ngg1i2jid9].[none:customer_state:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0e15faa0nunf2017x6ngg1i2jid9].[usr:Calculation_1985998476271620:qk]' shelf='rows' />
          </shelf-sorts>
