      <column caption='On-Time Delivery Rate' datatype='real' name='[Calculation_1985998435057664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_late] = 0 THEN [order_id] END)&#10;/&#10;COUNTD([order_id])&#10;* 100' />
      </column>
      <column caption='Avg Review Score' datatype='real' name='[Calculation_1985998436831233]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [review_score] &gt; 0 THEN [review_score] END)' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_1985998437367810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price]) / COUNTD([order_id])' />
      </column>
      <column caption='Delivery Status' datatype='string' name='[Calculation_1985998444761091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_late] = 0 THEN &quot;On Time&quot; ELSE &quot;Late&quot; END' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' name='[Calculation_1985998476271620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [is_late] = 1 THEN [order_id] END) / COUNTD([order_id]) * 100' />
      </column>
